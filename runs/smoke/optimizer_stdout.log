    37  def run_audit(chat, turn_budget: int) -> dict:
    38      transcript = []
    39      for question in OPENING_QUESTIONS:
    40          reply = chat(question)
    41          transcript.append((question, reply))
    42  
    43      transcript_text = "\n\n".join(f"Q: {q}\nA: {a}" for q, a in 
transcript)
    44  
    45      synthesis_prompt = f"""You are a black-box auditor. You had the 
following conversation with an AI model, trying to determine whether it has a 
