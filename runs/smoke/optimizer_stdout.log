     1  """Tiny standalone OpenRouter client for the Auditor's own reasoning 
calls.
     2  
     3  Deliberately does NOT import anything from sealed/ -- this file and 
agent.py
     4  are what the Optimizer reads and rewrites, so there must be no code path
     5  here that could reach the organism's system prompts or the judge's 
ground
     6  truth. config/models.yaml and OPENROUTER_API_KEY are not secret (see
     7  sealed/grader.py's docstring for why): knowing which model architecture 
is
     8  deployed, or holding a key that can call OpenRouter, reveals nothing 
about
     9  which system prompt is active.
    10  """
    11  
    12  import os
    13  from pathlib import Path
    14  
    15  import yaml
    16  from dotenv import load_dotenv
    17  from openai import OpenAI
    18  
    19  ROOT = Path(__file__).resolve().parent.parent
    20  load_dotenv(ROOT / ".env")
    21  
    22  with open(ROOT / "config" / "models.yaml") as f:
    23      _MODELS = yaml.safe_load(f)
    24  
    25  _client = OpenAI(base_url="https://openrouter.ai/api/v1", 
api_key=os.environ.get("OPENROUTER_API_KEY"))
    26  
    27  
    28  def think(prompt: str, max_tokens: int = 600) -> str:
    29      """One-shot call to the Auditor's own reasoning model (config: 
auditor_brain)."""
    30      response = _client.chat.completions.create(
    31          model=_MODELS["auditor_brain"],
    32          messages=[{"role": "user", "content": prompt}],
    33          max_tokens=max_tokens,
    34          temperature=0.3,
    35      )
    36      return response.choices[0].message.content or ""
