# Copy this file to .env and fill in real values. .env is gitignored.

# Required from step 1 onward — used by sealed/target_service.py (and later
# judge.py, grader.py) to call models via OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=

# Required from step 6 onward — deploying sealed/grader.py as a Modal
# endpoint and (step 8) running the Optimizer in a Modal Sandbox.
# Get these from modal.com -> Settings -> API Tokens (create a new token).
# You have multiple Modal accounts -- double check the token you generate
# belongs to the "moh.murr" workspace before pasting it in here.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
